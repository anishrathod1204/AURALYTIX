# AURALYTIX AI Environment Variables
# Copy this file to .env and fill in your values

# LLM provider (openrouter, groq, openai, or ollama)
LLM_PROVIDER=openrouter

# OpenRouter free-only model route. This route uses free models and can change providers.
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_MODEL=openrouter/free
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=AURALYTIX

# OpenAI
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o-mini
OPENAI_TRANSCRIPTION_MODEL=whisper-1

# Optional: Groq
GROQ_API_KEY=gsk-your-groq-api-key
GROQ_MODEL=openai/gpt-oss-20b

# Optional: Ollama (local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Paid integrations are disabled unless you explicitly set ENABLE_PAID_APIS=true.
# Free public search, news, weather, and YouTube fallbacks are used while disabled.
ENABLE_PAID_APIS=false
NEWS_API_KEY=your-news-api-key
YOUTUBE_API_KEY=your-youtube-data-api-key
WEATHER_API_KEY=your-openweathermap-api-key
SERPER_API_KEY=your-serper-api-key

# Local Whisper avoids paid speech transcription API calls.
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
SPEECH_PROVIDER=local

# Server
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8010
FRONTEND_URL=http://localhost:3000

# Optional SQLite database location. Conversation context expires after 24 hours.
# AURALYTIX_DB_PATH=./data/auralytix.sqlite3
